# MongoDB Atlas (Network Access: permitir 0.0.0.0/0 o IPs de Vercel)
MONGODB_URI=mongodb+srv://peneberto:clave@cluster.mongodb.net/optisave_comercial?retryWrites=true&w=majority

# Secreto para firmar JWT (genera uno largo y aleatorio en producción)
# JWT_SECRET=cambia-este-secreto-por-uno-seguro

# Opcional: orígenes CORS separados por coma (por defecto permite cualquier origen)
# CORS_ORIGIN=https://tu-proyecto.vercel.app

# Servicio Baileys (Docker) — proxy WhatsApp QR + envíos
BAILEYS_SERVICE_URL=http://localhost:3001
BAILEYS_SERVICE_API_KEY=optisave-dev-key
